geometry"/></mxCell></UserObject><UserObject label="Nyra · Contabilidad"  id="c15"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=10;fillColor=#1D2E73;fontColor=#FFFFFF;strokeColor=none;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="598" width="330" height="62" as="geometry"/></mxCell></UserObject><UserObject label="Revisa comprobación y registra en Aspel"  id="c16"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFFFFF;strokeColor=#D5D9E8;fontColor=#222222;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="390" y="598" width="520" height="62" as="geometry"/></mxCell></UserObject><UserObject label="Ale · Ingresos · Francisca · Cobranza"  id="c17"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=10;fillColor=#1D2E73;fontColor=#FFFFFF;strokeColor=none;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="676" width="330" height="62" as="geometry"/></mxCell></UserObject><UserObject label="Facturación y cobro"  id="c18"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFFFFF;strokeColor=#D5D9E8;fontColor=#222222;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="390" y="676" width="520" height="62" as="geometry"/></mxCell></UserObject><UserObject label="Alejandro · Flotilla"  id="c19"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=10;fillColor=#1D2E73;fontColor=#FFFFFF;strokeColor=none;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="754" width="330" height="62" as="geometry"/></mxCell></UserObject><UserObject label="Seguimiento de taller y liberación de vehículos"  id="c20"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFFFFF;strokeColor=#D5D9E8;fontColor=#222222;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="390" y="754" width="520" height="62" as="geometry"/></mxCell></UserObject><UserObject label="Glen · Sistemas"  id="c21"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=10;fillColor=#1D2E73;fontColor=#FFFFFF;strokeColor=none;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="832" width="330" height="62" as="geometry"/></mxCell></UserObject><UserObject label="Usuarios, permisos y cambios a la plataforma"  id="c22"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=0;fillColor=#FFFFFF;strokeColor=#D5D9E8;fontColor=#222222;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="390" y="832" width="520" height="62" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;Reglas de acceso&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Operaciones: todos en solo lectura; editan admins del portal y admins de Operaciones.&lt;br&gt;• Dinero (precio, utilidad, comisiones): solo clientes@, magali@, m.delao@, p.pinedo@, mercadotecnia@, mercadotecniatecnocontrol@gmail.com, rh@, c.acosta@.&lt;br&gt;• El técnico solo ve lo que se le deposita de viáticos.&lt;br&gt;• Gera (VH): solo calendario de servicios de VH, sin dinero, sin editar.&lt;br&gt;• Precios de Compras: Compras siempre; Ventas solo en lo que pidió.&lt;br&gt;• Gerentes pasan directo a Compras sin firma de jefe.&lt;br&gt;• Solo admins activan la alerta sísmica por usuario.&lt;br&gt;• Sin bloqueos por tareas pendientes (Paloma e Idaly).&lt;br&gt;• Ningún permiso se crea dentro de un módulo: todo en Usuarios y permisos.&lt;br&gt;&lt;br&gt;&lt;b&gt;Reglas de datos&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Productos: clave y descripción de Aspel.&lt;br&gt;• Coordenadas de estaciones: las de SUDI.&lt;br&gt;• Estaciones por nombre comercial; razón social y PL como dato adicional (PETROMAX = razón social, Petro Seven = nombre comercial).&lt;br&gt;• Nombres: nombre, segundo nombre, primer apellido, segundo apellido.&lt;br&gt;• Listados en orden alfabético y con buscador.&lt;br&gt;• &lt;b&gt;Nadie carga datos directo a la base&lt;/b&gt; sin respaldo y sin la misma validación del formulario."  id="c23"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;fillColor=#FFFDF2;strokeColor=#CFC6A0;fontColor=#444444;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="960" y="130" width="880" height="640" as="geometry"/></mxCell></UserObject></root></mxGraphModel></diagram><diagram id="p8" name="8 · Riesgos y plan"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1100" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject label="8 · Riesgos, pendientes y orden de trabajo"  id="c1"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;fontSize=24;fontStyle=1;fontColor=#1D2E73;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="40" as="geometry"/></mxCell></UserObject><UserObject label="Se trabaja en este orden. Cada paso cierra un riesgo. Los pendientes P1–P4 quedan dentro del paso que les corresponde."  id="c2"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1800" height="40" as="geometry"/></mxCell></UserObject><UserObject label="1"  id="c3"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;ellipse;fillColor=#E7402B;fontColor=#FFFFFF;strokeColor=none;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="145" y="140" width="44" height="44" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;Congelar cargas directas + respaldo y bitácora&lt;/b&gt;"  id="c4"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#1D2E73;fontColor=#222222;fontSize=11;strokeWidth=1.5;" 