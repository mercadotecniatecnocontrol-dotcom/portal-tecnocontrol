<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0"><diagram id="p0" name="0 · Cómo usar este mapa"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1000" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject label="Mapa de la plataforma · Portal Operativo Tecnocontrol"  id="c1"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;fontSize=24;fontStyle=1;fontColor=#1D2E73;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="40" as="geometry"/></mxCell></UserObject><UserObject label="Versión 0.1 · 2 de noviembre de 2026 · Documento de trabajo para Dirección. Fuente única de verdad sobre módulos, datos, flujos, permisos y riesgos."  id="c2"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1800" height="40" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;Cómo trabajar con este mapa&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. Cada pestaña de abajo es una vista: inventario, flujos, datos, autorizaciones, impacto y plan.&lt;br&gt;2. Pasa el mouse sobre cualquier caja para ver qué hace, quién la usa y a qué afecta.&lt;br&gt;3. Antes de pedir un cambio, búscalo en la pestaña &lt;b&gt;5 · Matriz de impacto&lt;/b&gt;: la fila te dice qué departamentos se ven afectados y quién lo autoriza.&lt;br&gt;4. Todo cambio aprobado se marca aquí primero (color amarillo = pendiente) y después se programa. Cuando se termina, pasa a verde.&lt;br&gt;5. Nadie cambia datos directo en la base sin que el cambio esté en este mapa.&lt;br&gt;&lt;br&gt;&lt;b&gt;Dónde vive&lt;/b&gt;: archivo &lt;i&gt;MAPA_PORTAL.drawio&lt;/i&gt; en el repositorio del portal. Se abre y se guarda en app.diagrams.net conectado a GitHub; cada guardado queda como versión."  id="c3"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;fillColor=#FFFDF2;strokeColor=#CFC6A0;fontColor=#444444;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="900" height="330" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;Simbología&lt;/b&gt;"  id="c4"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1000" y="120" width="180" height="24" as="geometry"/></mxCell></UserObject><UserObject label="Área / departamento"  id="c5"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=10;fillColor=#1D2E73;fontColor=#FFFFFF;strokeColor=none;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="148" width="180" height="28" as="geometry"/></mxCell></UserObject><UserObject label="Módulo del portal"  id="c6"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#1D2E73;fontColor=#1D2E73;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="1000" y="182" width="180" height="28" as="geometry"/></mxCell></UserObject><UserObject label="Página o app conectada"  id="c7"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#EEF1FA;strokeColor=#1D2E73;fontColor=#1D2E73;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="216" width="180" height="28" as="geometry"/></mxCell></UserObject><UserObject label="Dato en Supabase"  id="c8"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#1E4D31;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="250" width="180" height="28" as="geometry"/></mxCell></UserObject><UserObject label="Dato en Firebase"  id="c9"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFF4E5;strokeColor=#C77700;fontColor=#7A4A00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="284" width="180" height="28" as="geometry"/></mxCell></UserObject><UserObject label="Sistema externo"  id="c10"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#F2F2F2;strokeColor=#8A8A8A;dashed=1;fontColor=#444444;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="318" width="180" height="28" as="geometry"/></mxCell></UserObject><UserObject label="Correcto / terminado"  id="c11"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#E7F4EC;strokeColor=#2E7D4F;fontColor=#1E4D31;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="352" width="180" height="28" as="geometry"/></mxCell></UserObject><UserObject label="Pendiente / por confirmar"  id="c12"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FFF8E1;strokeColor=#E0A100;fontColor=#6B4E00;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="386" width="180" height="28" as="geometry"/></mxCell></UserObject><UserObject label="Riesgo activo"  id="c13"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;rounded=1;arcSize=8;fillColor=#FDECEA;strokeColor=#E7402B;fontColor=#8A1F12;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1000" y="420" width="180" height="28" as="geometry"/></mxCell></UserObject><UserObject label="&lt;b&gt;Pestañas&lt;/b&gt;&lt;br&gt;&lt;br&gt;1 · Inventario de la plataforma&lt;br&gt;2 · Flujo Ventas → Operaciones → Almacén → Pagos → Contabilidad&lt;br&gt;3 · Flujo Flotilla → taller → Pagos&lt;br&gt;4 · RH como centro del personal&lt;br&gt;5 · Fuentes oficiales de datos y duplicados&lt;br&gt;6 · Matriz de impacto (quién es dueño, escribe, lee, autoriza)&lt;br&gt;7 · Autorizaciones y reglas de acceso&lt;br&gt;8 · Riesgos, pendientes y orden de trabajo"  id="c14"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;shape=note;size=14;fillColor=#FFFDF2;strokeColor=#CFC6A0;fontColor=#444444;fontSize=11;align=left;spacingLeft=8;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="40" y="480" width="900" height="230" as="geometry"/></mxCell></UserObject></root></mxGraphModel></diagram><diagram id="p1" name="1 · Inventario"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2300" pageHeight="1200" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><UserObject label="1 · Inventario de la plataforma"  id="c1"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;fontSize=24;fontStyle=1;fontColor=#1D2E73;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1600" height="40" as="geometry"/></mxCell></UserObject><UserObject label="Qué existe, quién lo usa y dónde se guarda. Pasa el mouse sobre cada caja para ver el detalle."  id="c2"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;text;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="62" width="1800" height="40" as="geometry"/></mxCell></UserObject><UserObject label="ÁREAS"  id="c3"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;swimlane;horizontal=0;startSize=34;fillColor=#1D2E73;fontColor=#FFFFFF;strokeColor=#1D2E73;fontStyle=1;fontSize=12;swimlaneFillColor=#F7F8FC;rounded=0;" vertex="1" parent="1"><mxGeometry x="30" y="120" width="2200" height="110" as="geometry"/></mxCell></UserObject><UserObject label="PORTAL · index.html · GitHub Pages"  id="c4"><mxCell style="whiteSpace=wrap;html=1;fontFamily=Helvetica;swimlane;horizontal=0;startSize=34;fillColor=#1D2E73;fontColor=#FFFFFF;strokeColor=#1D2E73;fontStyle=1;fontSize=12;swimlaneFillColor=#F7F8FC;rounded=0;" vertex="1" parent="1"><mxG